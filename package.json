{
  "name": "@morpho-org/sdks",
  "version": "0.0.0",
  "description": "Collection of SDKs to ease interactions with the Morpho protocol and Morpho Vaults",
  "author": "Morpho Association <contact@morpho.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morpho-org/sdks.git"
  },
  "homepage": "https://github.com/morpho-org/sdks",
  "bugs": {
    "url": "https://github.com/morpho-org/sdks/issues",
    "email": "contact@morpho.org"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "@fast-check/vitest": "^0.5.0",
      "typescript": "7.0.2",
      "vitest": "^4.1.12",
      "fast-check": "^4.9.0"
    }
  },
  "overrides": {
    "minimatch": "11.0.8",
    "tmp": "0.2.7",
    "ws@8.21.0": "8.23.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "bufferutil",
    "esbuild",
    "keccak",
    "secp256k1",
    "utf-8-validate"
  ],
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "install:checked": "node scripts/check-release-age.ts --all && bun install --frozen-lockfile",
    "deps:add": "node scripts/update-dependencies.ts add",
    "deps:update": "node scripts/update-dependencies.ts update",
    "prepare": "husky",
    "build": "bun run --filter './packages/**' --if-present build",
    "build:ci": "bun run verify:deployless-artifacts && bun run --filter './packages/**' --if-present build",
    "lint": "biome check && bun run jsdoc:coverage:check && bun run lint:address && bun run lint:security-invariants && bun run typecheck:scripts && bun run knip",
    "lint:ci": "biome check --config-path=biome.ci.json && bun run jsdoc:coverage:check && bun run lint:address && bun run lint:security-invariants && bun run typecheck:scripts && bun run knip",
    "knip": "knip",
    "lint:security-invariants": "node --no-warnings=ExperimentalWarning scripts/lint/security-invariants.ts",
    "lint:address": "node --no-warnings=ExperimentalWarning scripts/lint/checksum-address.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "jsdoc:coverage": "node --no-warnings=ExperimentalWarning scripts/jsdoc-coverage.ts",
    "jsdoc:coverage:check": "node --no-warnings=ExperimentalWarning scripts/jsdoc-coverage.ts --self-check",
    "docs:build": "typedoc",
    "test": "dotenv -- vitest",
    "test:ci": "dotenv -- vitest run --coverage",
    "test:e2e": "dotenv -- vitest run --project morpho-sdk-fork --project evm-simulation-fork packages/morpho-sdk/test/e2e packages/evm-simulation/test/e2e",
    "test:coverage": "bun run test --coverage",
    "coverage:report": "genhtml --hierarchical --sort --prefix \"$(pwd)\" -o coverage/lcov coverage/lcov.info",
    "changeset": "changeset",
    "version": "changeset version && node scripts/generate-package-versions.ts",
    "release": "changeset publish",
    "verify:deployless-artifacts": "bun run --filter @morpho-org/blue-sdk-viem compile && bun run --filter @morpho-org/midnight-sdk compile && git diff --exit-code HEAD -- packages/blue-sdk-viem/src/queries packages/midnight-sdk/src/queries && test -z \"$(git ls-files --others --exclude-standard -- packages/blue-sdk-viem/src/queries packages/midnight-sdk/src/queries)\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@fast-check/vitest": "catalog:",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "dotenv-cli": "^11.0.0",
    "fast-check": "catalog:",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "6.37.0",
    "lint-staged": "^17.2.0",
    "solc": "0.8.36",
    "typedoc": "^0.28.20",
    "typescript": "catalog:",
    "viem": "2.55.10",
    "vite": "8.2.6",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*.{json,gql}": "biome check --write --no-errors-on-unmatched",
    "*.[tj]s*": "biome check --write --no-errors-on-unmatched && bun run lint:address"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
