{
  "name": "@morpho-org/sdks",
  "version": "0.0.0",
  "description": "Collection of SDKs to ease interactions with the Morpho protocol and Morpho Vaults",
  "author": "Morpho Association <contact@morpho.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morpho-org/sdks.git"
  },
  "homepage": "https://github.com/morpho-org/sdks",
  "bugs": {
    "url": "https://github.com/morpho-org/sdks/issues",
    "email": "contact@morpho.org"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.28.0+sha512.8ed239371de82244b6cccf9e2023c18ea8439961f2ec3fe898913b9f7ee2e76ca0a45717580aca3c7997c135f6d4f5de4524cbeee1a2ccac430c03d134e2a48c",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm -r --if-present build",
    "build:ci": "pnpm verify:deployless-artifacts && pnpm -r --if-present --filter './packages/**' build",
    "lint": "biome check && pnpm jsdoc:coverage:check && pnpm lint:address && pnpm lint:security-invariants && pnpm typecheck:scripts && pnpm knip",
    "lint:ci": "biome check --config-path=biome.ci.json && pnpm jsdoc:coverage:check && pnpm lint:address && pnpm lint:security-invariants && pnpm typecheck:scripts && pnpm knip",
    "knip": "knip",
    "lint:security-invariants": "node --no-warnings=ExperimentalWarning scripts/lint/security-invariants.ts",
    "lint:address": "node --no-warnings=ExperimentalWarning scripts/lint/checksum-address.ts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "jsdoc:coverage": "node --no-warnings=ExperimentalWarning scripts/jsdoc-coverage.ts",
    "jsdoc:coverage:check": "node --no-warnings=ExperimentalWarning scripts/jsdoc-coverage.ts --self-check",
    "docs:build": "typedoc",
    "test": "dotenv -- vitest",
    "test:ci": "dotenv -- vitest run --coverage",
    "test:coverage": "pnpm test --coverage",
    "coverage:report": "genhtml --hierarchical --sort --prefix \"$(pwd)\" -o coverage/lcov coverage/lcov.info",
    "changeset": "changeset",
    "version": "changeset version && node scripts/generate-midnight-package-version.ts",
    "release": "changeset publish",
    "verify:deployless-artifacts": "pnpm --filter @morpho-org/blue-sdk-viem compile && pnpm --filter @morpho-org/midnight-sdk compile && git diff --exit-code HEAD -- packages/blue-sdk-viem/src/queries packages/midnight-sdk/src/queries && test -z \"$(git ls-files --others --exclude-standard -- packages/blue-sdk-viem/src/queries packages/midnight-sdk/src/queries)\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "dotenv-cli": "^11.0.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "knip": "6.37.0",
    "lint-staged": "^17.2.0",
    "solc": "0.8.36",
    "typedoc": "^0.28.20",
    "typescript": "catalog:",
    "undici": "^8.11.2",
    "viem": "2.55.10",
    "vite": "8.2.0",
    "vitest": "catalog:"
  },
  "lint-staged": {
    "*.{json,gql}": "biome check --write --no-errors-on-unmatched",
    "*.[tj]s*": "biome check --write --no-errors-on-unmatched && lint:address"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
