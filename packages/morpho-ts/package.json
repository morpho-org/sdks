{
  "name": "@morpho-org/morpho-ts",
  "description": "TypeScript package to handle all things time & format-related.",
  "version": "4.1.0",
  "author": "Morpho Association <contact@morpho.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morpho-org/sdks.git",
    "directory": "packages/morpho-ts"
  },
  "homepage": "https://github.com/morpho-org/sdks",
  "bugs": {
    "url": "https://github.com/morpho-org/sdks/issues",
    "email": "contact@morpho.org"
  },
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./abis": "./src/abis.ts",
    "./abis/marketParams": "./src/abis/marketParams.ts",
    "./abis/midnight": "./src/abis/midnight.ts"
  },
  "typesVersions": {
    "*": {
      "abis": [
        "src/abis.ts"
      ],
      "abis/marketParams": [
        "src/abis/marketParams.ts"
      ],
      "abis/midnight": [
        "src/abis/midnight.ts"
      ]
    }
  },
  "files": [
    "lib",
    "MIGRATION-v2-to-v3.md",
    "MIGRATION-v3-to-v4.md"
  ],
  "scripts": {
    "prepublish": "pnpm build",
    "build": "tsc --noEmit && pnpm build:cjs && pnpm build:esm",
    "build:cjs": "tsc --build tsconfig.build.cjs.json && echo '{\"type\":\"commonjs\"}' > lib/cjs/package.json",
    "build:esm": "tsc --build tsconfig.build.esm.json && echo '{\"type\":\"module\"}' > lib/esm/package.json"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "fast-check": "catalog:"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./lib/esm/index.d.ts",
        "import": "./lib/esm/index.js",
        "require": "./lib/cjs/index.js"
      },
      "./abis": {
        "types": "./lib/esm/abis.d.ts",
        "import": "./lib/esm/abis.js",
        "require": "./lib/cjs/abis.js"
      },
      "./abis/marketParams": {
        "types": "./lib/esm/abis/marketParams.d.ts",
        "import": "./lib/esm/abis/marketParams.js",
        "require": "./lib/cjs/abis/marketParams.js"
      },
      "./abis/midnight": {
        "types": "./lib/esm/abis/midnight.d.ts",
        "import": "./lib/esm/abis/midnight.js",
        "require": "./lib/cjs/abis/midnight.js"
      }
    },
    "main": "./lib/cjs/index.js",
    "types": "./lib/esm/index.d.ts",
    "typesVersions": {
      "*": {
        "abis": [
          "lib/esm/abis.d.ts"
        ],
        "abis/marketParams": [
          "lib/esm/abis/marketParams.d.ts"
        ],
        "abis/midnight": [
          "lib/esm/abis/midnight.d.ts"
        ]
      }
    }
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  }
}
