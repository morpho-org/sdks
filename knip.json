{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["genhtml", "mkfifo"],
  "ignoreIssues": {
    "packages/blue-sdk-viem/src/MetaMorphoAction.ts": ["duplicates"],
    "packages/morpho-ts/src/addresses.ts": ["duplicates"],
    "packages/evm-simulation/src/result.ts": ["types"],
    "packages/evm-simulation/src/simulate/backends/parse-response.ts": [
      "types"
    ],
    "packages/evm-simulation/src/simulate/plan/plan-execution.ts": ["types"]
  },
  "workspaces": {
    ".": {
      "ignoreDependencies": ["undici"]
    },
    "packages/blue-sdk-viem": {
      "ignore": ["src/queries/**/index.ts"]
    },
    "packages/midnight-sdk": {
      "ignore": ["src/queries/**/index.ts"]
    },
    "packages/morpho-sdk": {
      "entry": ["examples/**/*.ts"]
    },
    "packages/wdk-protocol-lending-morpho-evm": {
      "entry": ["bare.js"]
    }
  }
}
