{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.context",
      "!**/lib",
      "!**/.vscode",
      "!**/cache",
      "!**/coverage",
      "!**/artifacts"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noForEach": "off",
        "noBannedTypes": "off",
        "useMaxParams": { "level": "error", "options": { "max": 2 } }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "useExhaustiveDependencies": "error"
      },
      "style": {
        "noParameterAssign": "error",
        "useBlockStatements": "off",
        "noUnusedTemplateLiteral": "off",
        "noNonNullAssertion": "off",
        "noUselessElse": "error"
      },
      "suspicious": {
        "useGetterReturn": "off",
        "noAssignInExpressions": "off",
        "noFallthroughSwitchClause": "off",
        "noNonNullAssertedOptionalChain": "off",
        "useIterableCallbackReturn": "off",
        "noShadow": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/*/src/**", "!**/*.test.ts", "!**/test/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "warn",
              "options": {
                "maxAllowedComplexity": 50
              }
            }
          },
          "style": {
            "noNestedTernary": "warn",
            "noNonNullAssertion": "warn"
          },
          "suspicious": { "noExplicitAny": "warn", "noTsIgnore": "warn" }
        }
      }
    },
    {
      "includes": [
        "packages/morpho-sdk/src/**",
        "!**/*.test.ts",
        "!**/test/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 50
              }
            }
          },
          "style": {
            "noNestedTernary": "error",
            "noNonNullAssertion": "error"
          },
          "suspicious": { "noExplicitAny": "error", "noTsIgnore": "error" }
        }
      }
    }
  ]
}
