{
  "name": "package tags",
  "target": "tag",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["refs/tags/@morpho-org/*"], "exclude": [] }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "update",
      "parameters": { "update_allows_fetch_and_merge": false }
    },
    { "type": "non_fast_forward" },
    { "type": "deletion" }
  ]
}
